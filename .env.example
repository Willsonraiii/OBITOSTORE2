# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# Port the service listens on (inside the container / on the VM)
PORT=3005

# Access token for the API. Set a long random string before exposing the
# service (openssl rand -hex 24). Leave empty ONLY for local testing.
ACCESS_TOKEN=

# Delete abandoned/undownloaded jobs after this many milliseconds (default 1h)
JOB_TTL_MS=3600000

# Kill a job that processes longer than this (default 30 min)
PROCESS_TIMEOUT_MS=1800000

# ---- "Post to TikTok" (Login Kit + Content Posting API) ----
# Create an app at https://developers.tiktok.com -> add Login Kit + Content Posting API products.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must match the Redirect URI registered in the portal EXACTLY (https, no trailing slash differences)
TIKTOK_REDIRECT_URI=https://obitostudio.willsonrai.com.np/api/tiktok/callback
# video.upload = send to the creator's TikTok drafts/inbox, video.publish = Direct Post. Only request what the portal approved.
TIKTOK_SCOPES=user.info.basic,video.upload,video.publish
# Set to true ONLY after TikTok approves the Content Posting API audit (until then Direct Post is private-only)
TIKTOK_AUDITED=false
# openssl rand -hex 32  (signs the OAuth state; random per boot if empty)
TIKTOK_STATE_SECRET=
# openssl rand -hex 32  (AES-256-GCM key for stored TikTok tokens; strongly recommended)
TIKTOK_TOKEN_KEY=

# --- Members store cloud sync (GitHub Gist) ---
# Create a SECRET gist containing members.json, then a fine-grained token with ONLY the "Gists: read and write" permission.
MEMBERS_GIST_ID=
MEMBERS_GIST_TOKEN=
